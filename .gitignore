# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local screenshot / debug artifacts
.tmp/

# typescript
*.tsbuildinfo
next-env.d.ts

# npm-ci test backup of node_modules (local only, never commit)
/node_modules_pre_ci_*

# playwright auth/session artifacts (may contain login state)
/.playwright

# root-level debug scripts and captures
/_*.js
/_screenshot.png
/-

# local scratch parked for deletion, transfer archives, and one-off exports.
# Listed so a stray `git add -A` can never sweep them into a commit.
/_to_delete/
/_xfer-media.tgz
/altair-overview-*.json
*.tgz

# Local scratch-only SQL runner (holds a connection string). Never committed.
/.scratch-sql.mjs
/.env.scratch.local
/.scratch-*

# UI-audit evidence corpus. The reports, findings, and capture scripts under
# ui-audit/ ARE tracked — they are the durable output. The screenshots are not:
# they run to ~88 MB, and because they are captured from an authenticated
# session they contain real tenant data (customer names, emails, phone numbers,
# addresses, record ids). Regenerate them locally with ui-audit/capture-audit.mjs.
/ui-audit/SCREENSHOTS/

# Claude Code local machine settings (per-developer permission grants).
# .claude/launch.json is intentionally tracked — it is the shared dev-server
# definition and contains no machine-specific values.
/.claude/settings.local.json

# Supabase CLI scratch state.
# NOTE: supabase/.temp/cli-latest is ALREADY TRACKED, so this rule does not
# untrack it — it only stops new files under .temp/ being added. Untracking the
# existing file needs a deliberate separate change:
#   git rm --cached supabase/.temp/cli-latest
/supabase/.temp/

# Prestige campaign screenshot output (regenerate with ui-audit/shots.mjs)
/ui-audit/SHOTS/

# Release smoke captures (regenerate with ui-audit/smoke-release.mjs). Same
# reason as the others: they are authenticated screenshots of real customer
# names, emails and phone numbers.
/ui-audit/smoke/

# Probe output. Regenerate with the probe that writes it; it captures text
# pulled straight off authenticated pages, so it can carry customer data.
/ui-audit/text-contrast.json

# Library thumbnails exported for a curated Studio draft. NOT tracked, and the
# distinction from public/studio/<episode>/ matters: those are slides this
# project rendered and owns, while these are downsampled frames of the private
# asset library, exported only so an operator can SEE the shot a curation
# chose. Committing them would put a private library into a public deploy to
# solve a local-preview problem. Regenerate with AltairDemoTool's
# production/slide-system/export-library-previews.mjs; a draft whose thumbnails
# are absent still opens and names every asset it chose.
/public/studio/library/

# The 9:16 derivatives of those same thumbnails, and the catalog that indexes
# them. Same reasoning as above and the same regeneration step: the library is
# private, the panel that browses it is a local-preview facility, and a catalog
# of a private library is still a description of a private library. Rebuild
# both with D:/Altair-HVAC-Library/_manifest/build-catalog.mjs.
/public/studio/library-v/
/public/studio/hvac-catalog.json

# The practice episode's PHOTOGRAPH frames. Its cards and its narration are
# rendered by this project and tracked below them, but these 21 files are
# full-resolution crops of the private HVAC library staged where the render
# worker and the scene bake look for them. Committing full-size library
# imagery into a public deploy is a bigger step than solving the local
# staging problem it solves. Restage with:
#   node --import ./scripts/video-editor-register.mjs \
#     scripts/practice/build-practice-episode.mjs
/public/studio/compressor-01/*.jpg
!/public/studio/compressor-01/clip-beat-*.jpg

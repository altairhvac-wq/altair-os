# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local screenshot / debug artifacts
.tmp/

# typescript
*.tsbuildinfo
next-env.d.ts

# npm-ci test backup of node_modules (local only, never commit)
/node_modules_pre_ci_*

# playwright auth/session artifacts (may contain login state)
/.playwright

# root-level debug scripts and captures
/_*.js
/_screenshot.png
/-

# local scratch parked for deletion, transfer archives, and one-off exports.
# Listed so a stray `git add -A` can never sweep them into a commit.
/_to_delete/
/_xfer-media.tgz
/altair-overview-*.json
*.tgz

# Local scratch-only SQL runner (holds a connection string). Never committed.
/.scratch-sql.mjs
/.env.scratch.local
/.scratch-*

# UI-audit evidence corpus. The reports, findings, and capture scripts under
# ui-audit/ ARE tracked — they are the durable output. The screenshots are not:
# they run to ~88 MB, and because they are captured from an authenticated
# session they contain real tenant data (customer names, emails, phone numbers,
# addresses, record ids). Regenerate them locally with ui-audit/capture-audit.mjs.
/ui-audit/SCREENSHOTS/

# Claude Code local machine settings (per-developer permission grants).
# .claude/launch.json is intentionally tracked — it is the shared dev-server
# definition and contains no machine-specific values.
/.claude/settings.local.json

# Supabase CLI scratch state.
# NOTE: supabase/.temp/cli-latest is ALREADY TRACKED, so this rule does not
# untrack it — it only stops new files under .temp/ being added. Untracking the
# existing file needs a deliberate separate change:
#   git rm --cached supabase/.temp/cli-latest
/supabase/.temp/

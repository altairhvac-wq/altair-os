    "verify:publish-guard": "node scripts/verify-marketing-publish-guard.mjs",
    "verify:migrations": "node scripts/verify-marketing-migrations.mjs",
    "verify:channels": "node scripts/verify-marketing-channels.mjs",
    "verify:delivery": "node scripts/verify-marketing-delivery.mjs",
    "typecheck:readonly": "node scripts/typecheck.mjs --readonly",

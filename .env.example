# Supabase (required for backend integration)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Enable alpha hardening behaviors locally (also on by default in production)
# NEXT_PUBLIC_ALPHA_HARDENING=true

# In-app beta bug reporter (on by default). Set to false after beta ends.
# NEXT_PUBLIC_SHOW_BETA_BUG_REPORT_BUTTON=false

# Optional: service role for server-only admin tasks (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Cron jobs (server-only — Vercel sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Team invite email (Resend). Invites still save without these; UI reports delivery honestly.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Public app URL used in invite and estimate approval emails.
# Use a full URL with https:// (for example, https://your-app.vercel.app).
# On Vercel, falls back to https://VERCEL_URL when unset.
NEXT_PUBLIC_APP_URL=

# Meta Pixel (optional — marketing PageView tracking). Omit to disable.
# Set in Vercel Production (and Preview if using Meta Test Events).
NEXT_PUBLIC_META_PIXEL_ID=1366160172145825

# Facebook / Meta OAuth — Marketing Hub Connected Accounts (server-only).
# Connect stage uses pages_show_list + public_profile only (no posting scopes).
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# Optional override; defaults to {NEXT_PUBLIC_APP_URL}/api/marketing/connected-accounts/facebook/callback
# FACEBOOK_REDIRECT_URI=
# Optional Graph API version override (default v22.0)
# FACEBOOK_GRAPH_API_VERSION=v22.0
# AES-256-GCM key for OAuth token ciphertext (32 bytes, base64). Required before Connect.
# Generate with: openssl rand -base64 32
# INTEGRATIONS_ENCRYPTION_KEY=

# Mapbox (optional — Dispatch job-location map). Public token for GL JS tiles + geocoding.
# Set the same value in Vercel as NEXT_PUBLIC_MAPBOX_TOKEN. Never commit real tokens.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional local dev only: redirect billing emails (estimates/invoices) away from customers.
# Never set in production Vercel — removes real customer delivery for beta.
# EMAIL_RECIPIENT_OVERRIDE=you@example.com

# SMS (server-only — Altair-managed Twilio for payment-link texts)
# SMS_PROVIDER=twilio
# SMS_FROM_NUMBER=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# Stripe webhooks — Connect customer invoice payments (server-only)
STRIPE_WEBHOOK_SECRET=

# Stripe webhooks — Altair SaaS subscription billing (server-only; never reuse STRIPE_WEBHOOK_SECRET)
STRIPE_BILLING_WEBHOOK_SECRET=

# Stripe platform secret key (server-only — never expose to the browser)
# Used by Connect invoice payments and by Altair SaaS subscription Checkout (platform account).
STRIPE_SECRET_KEY=

# Altair SaaS subscription Price IDs (server-only; never trust client Price IDs)
# Canonical interval-aware names used by subscription Checkout (catalog source of truth).
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# Legacy single Price IDs (unused by Checkout; kept for local/env transition only)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# AI Assist (OpenAI, server-only — never expose keys to the browser)
OPENAI_API_KEY=
# Optional model override; defaults to gpt-4o-mini server-side when unset.
AI_MODEL=
# Disabled by default. Set to true to enable server-side draft generation.
AI_FEATURES_ENABLED=false

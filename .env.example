# =============================================================================
# Altair OS environment configuration
# =============================================================================
#
# Copy to .env.local for development. NEVER commit a filled-in copy: .gitignore
# excludes .env* apart from this file.
#
# Every variable below carries a classification. `npm run verify:production-config`
# and the in-app system check both read the same classification, so a missing
# REQUIRED value fails loudly instead of degrading silently in production.
#
#   [REQUIRED]   Production will not function correctly without it.
#   [OPTIONAL]   Feature stays off, or falls back, when unset. Safe to omit.
#   [DEV-ONLY]   Local development only. Must NOT be set in production Vercel.
#   [DANGEROUS]  Changes customer-visible behavior if set incorrectly. Read the
#                note before setting one of these in any deployed environment.
#
# =============================================================================

# [REQUIRED] Supabase — database, auth, and storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [OPTIONAL] Enable alpha hardening behaviors locally (on by default in production)
# NEXT_PUBLIC_ALPHA_HARDENING=true

# [OPTIONAL] In-app beta bug reporter (on by default). Set to false after beta ends.
# NEXT_PUBLIC_SHOW_BETA_BUG_REPORT_BUTTON=false

# [REQUIRED] Service role for server-only admin tasks and webhook processing.
# Bypasses RLS. Never expose to the browser, never send to a client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# [REQUIRED] Cron jobs (server-only — Vercel sends Authorization: Bearer <CRON_SECRET>).
# Without it every /api/cron/* route answers 503 and no scheduled work runs.
CRON_SECRET=

# [REQUIRED for customer delivery] Transactional email (Resend). Estimates,
# invoices, payment links and team invites still save without these, and the UI
# reports delivery honestly — but nothing reaches a customer.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Public app URL used in invite and estimate approval emails.
# Use a full URL with https:// (for example, https://your-app.vercel.app).
# On Vercel, falls back to https://VERCEL_URL when unset.
NEXT_PUBLIC_APP_URL=

# [OPTIONAL] Meta Pixel — marketing PageView tracking. Omit to disable.
# Set in Vercel Production (and Preview if using Meta Test Events).
NEXT_PUBLIC_META_PIXEL_ID=1366160172145825

# [OPTIONAL] Facebook / Meta OAuth — Marketing Hub Connected Accounts (server-only).
# Connect stage uses pages_show_list + public_profile only (no posting scopes).
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# Optional override; defaults to {NEXT_PUBLIC_APP_URL}/api/marketing/connected-accounts/facebook/callback
# FACEBOOK_REDIRECT_URI=
# Optional Graph API version override (default v22.0)
# ONE version for every Meta call — OAuth, Page feed, photos, Instagram, and
# both Reel flows including the rupload.facebook.com upload host. There is
# deliberately no second pin anywhere in the codebase: a Reel flow on a
# different version than the OAuth flow that minted its token is a class of
# bug nobody finds until a token behaves unexpectedly.
#
# Meta's policy: a version stops working two years after its SUCCESSOR ships.
# v22.0 (released 21 Jan 2025) is superseded by v23.0, so it remains callable
# into 2027. Reels need v14.0 or later; anything older is refused with an
# explanation rather than an opaque Graph error.
# FACEBOOK_GRAPH_API_VERSION=v22.0
# AES-256-GCM key for OAuth token ciphertext (32 bytes, base64). Required before Connect.
# Generate with: openssl rand -base64 32
# INTEGRATIONS_ENCRYPTION_KEY=

# [OPTIONAL] Mapbox — Dispatch job-location map. Public token for GL JS tiles + geocoding.
# Set the same value in Vercel as NEXT_PUBLIC_MAPBOX_TOKEN. Never commit real tokens.
NEXT_PUBLIC_MAPBOX_TOKEN=

# [DANGEROUS] [DEV-ONLY] Redirect ALL outbound email away from real recipients.
#
# Set this locally to keep estimate, invoice, payment-link and team-invite mail
# out of real inboxes while testing.
#
# It is IGNORED in production. It used to redirect there too, logging a warning
# nobody read, which meant one stale Vercel variable could silently intercept
# every customer email indefinitely. The override is now refused when
# NODE_ENV=production: mail goes to the real recipient and the misconfiguration
# is reported to the error monitor. See lib/email/recipient.ts.
#
# Deprecated aliases, still read so a misconfigured Vercel project is visible:
#   TEST_EMAIL, RESEND_TEST_EMAIL, EMAIL_OVERRIDE_TO
# EMAIL_RECIPIENT_OVERRIDE=you@example.com

# [DANGEROUS] [OPTIONAL] SMS (server-only — Twilio for payment-link texts).
#
# DISABLED BY DEFAULT, AND THAT IS THE CORRECT LAUNCH POSITION.
#
# Outbound payment-link texts include STOP language, but nothing processes an
# inbound STOP reply yet: there is no inbound webhook, so a recipient who
# replies STOP is not recorded as opted out and the next link is sent anyway.
# Under US TCPA rules, soliciting an opt-out keyword and then ignoring it
# carries per-message statutory exposure.
#
# Enabling outbound SMS therefore requires BOTH:
#   SMS_PROVIDER=twilio            (plus the credentials below)
#   SMS_INBOUND_STOP_HANDLING=live (an explicit assertion that inbound STOP
#                                   handling is deployed and processing replies)
#
# With the first set and the second absent, sending fails closed and the
# configuration is reported as a compliance error. See lib/sms/env.ts.
# SMS_PROVIDER=twilio
# SMS_FROM_NUMBER=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# SMS_INBOUND_STOP_HANDLING=live

# [REQUIRED] Stripe webhooks — Connect customer invoice payments (server-only)
STRIPE_WEBHOOK_SECRET=

# [REQUIRED] Stripe webhooks — Altair SaaS subscription billing (server-only;
# never reuse STRIPE_WEBHOOK_SECRET)
STRIPE_BILLING_WEBHOOK_SECRET=

# [REQUIRED] Stripe platform secret key (server-only — never expose to the browser)
# Used by Connect invoice payments and by Altair SaaS subscription Checkout (platform account).
STRIPE_SECRET_KEY=

# [REQUIRED] Altair SaaS subscription Price IDs (server-only; never trust client Price IDs)
# Canonical interval-aware names used by subscription Checkout (catalog source of truth).
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# Legacy single Price IDs (unused by Checkout; kept for local/env transition only)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# [DEV-ONLY] Demo Tool integration — never set in production Vercel
# Used by: GET /api/demo/fingerprint and scripts/save-demo-playwright-auth.mjs
# The fingerprint value must match ALTAIR_DEMO_FINGERPRINT in the demo tool .env.
# DEMO_TOOL_FINGERPRINT=altair-demo-local-v1
#
# Credentials for the dedicated demo capture account (never a real user account).
# Run: node scripts/save-demo-playwright-auth.mjs  — then set the path in the demo tool.
# DEMO_CAPTURE_EMAIL=
# DEMO_CAPTURE_PASSWORD=

# [OPTIONAL] AI Assist (OpenAI, server-only — never expose keys to the browser).
# Note: the per-request guardrail is process-local, so it does not bound spend
# across serverless instances. Set a hard spend cap on the OpenAI key itself.
OPENAI_API_KEY=
# Optional model override; defaults to gpt-4o-mini server-side when unset.
AI_MODEL=
# Disabled by default. Set to true to enable server-side draft generation.
AI_FEATURES_ENABLED=false

# Agent Platform bridge (cross-repo marketing integration) -------------------
# The Altair Agent Platform runs on the founder's machine behind NAT and
# cannot be called into, so it PUSHES its marketing read model to
# POST /api/agent/snapshot. All three must be set for the route to accept
# anything; unset, it returns 503 and stores nothing.
#
# AGENT_INGEST_SECRET      shared bearer credential, server-side only, never
#                          sent to a browser. Generate with:
#                            node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#                          Do NOT reuse CRON_SECRET.
# AGENT_PLATFORM_COMPANY_ID the company slug the platform sends (its own
#                          ALTAIR_COMPANY_ID, e.g. "altair"). Checked against
#                          the payload; a mismatch is a 403.
# AGENT_INGEST_COMPANY_ID  the public.companies.id UUID that slug maps to in
#                          this database. The target company is bound from
#                          here, never from the payload.
# AGENT_INGEST_SECRET=
# AGENT_PLATFORM_COMPANY_ID=altair
# AGENT_INGEST_COMPANY_ID=

# Error monitoring (server-only) ---------------------------------------------
# [REQUIRED in production] Without a DSN the application still runs, but every
# failure — including a Stripe webhook that has started returning 500 — is
# invisible outside the platform log stream. That is the condition the launch
# audit called a P0.
#
# With SENTRY_DSN unset the integration is a complete no-op, so local
# development and CI need no credential.
#
# Wiring lives in lib/operations/monitoring.ts (the only module that imports the
# vendor SDK) and instrumentation.ts. Prove delivery in development with:
#   POST /api/dev/monitoring-check
# SENTRY_DSN=
# Deployment environment label for grouping. Falls back to VERCEL_ENV, then NODE_ENV.
# SENTRY_ENVIRONMENT=production
# Performance tracing sample rate, 0..1. Defaults to 0 (errors only, no tracing spend).
# SENTRY_TRACES_SAMPLE_RATE=0

# Platform administration (server-only) --------------------------------------
# [REQUIRED in production] Comma-separated allowlist of internal platform-admin
# email addresses. Grants access to /platform, the reconciliation dashboard, and
# founder marketing publishing.
#
# This was previously a hard-coded literal in lib/database/platform-admin.ts, so
# granting or revoking internal access needed a code change and a deploy.
#
# Server-only: never prefix with NEXT_PUBLIC_. Compared case-insensitively after
# trimming; malformed entries are dropped and an empty result fails closed
# (nobody is a platform admin).
# PLATFORM_ADMIN_EMAILS=founder@example.com,ops@example.com

# Marketing media ingest (server-only) ---------------------------------------
# [OPTIONAL] Machine-to-machine upload of rendered video into the private
# marketing-media bucket, used by POST /api/marketing/media/ingest.
#
# Both must be set or the route answers 401/403 and stores nothing. The company
# is bound from configuration, never from the request, so a valid secret cannot
# write into a different tenant.
#
# ALTAIR_MEDIA_INGEST_SECRET      shared bearer credential. Generate with:
#                                   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#                                 Do NOT reuse CRON_SECRET or AGENT_INGEST_SECRET.
# ALTAIR_MEDIA_INGEST_COMPANY_ID  the public.companies.id UUID allowed to ingest.
# ALTAIR_MEDIA_INGEST_SECRET=
# ALTAIR_MEDIA_INGEST_COMPANY_ID=

# Page-surface feature flags -------------------------------------------------
# [OPTIONAL] Gates North Star page canvases, loading states, and detail/list
# surface variants. Admin shell chrome is always on and unaffected.
# Unset means the legacy page surfaces render.
# NEXT_PUBLIC_NORTH_STAR_SHELL=true

# Local development conveniences ---------------------------------------------
# [DEV-ONLY] Extra origins allowed to reach `next dev` (comma-separated).
# LAN IPv4 addresses are detected automatically; add hostnames here.
# DEV_ALLOWED_ORIGINS=

# [DEV-ONLY] Founder marketing screenshot capture account.
# Run: npm run capture:founder-auth
# FOUNDER_CAPTURE_EMAIL=
# FOUNDER_CAPTURE_PASSWORD=
